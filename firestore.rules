rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      function signedIn() {
        return request.auth != null;
      }

      function ownsExistingGame() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }

      function ownsIncomingGame() {
        return signedIn() && request.resource.data.userId == request.auth.uid;
      }

      function validGame() {
        return request.resource.data.keys().hasAll([
          'userId', 'appId', 'title', 'description', 'date',
          'imageUrl', 'rating', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'appId', 'title', 'description', 'date', 'genre', 'mood',
          'imageUrl', 'rating', 'isFavorite', 'createdAt', 'updatedAt'
        ])
        && (request.resource.data.keys().hasAll(['genre'])
          || request.resource.data.keys().hasAll(['mood']))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 3000
        && (!request.resource.data.keys().hasAll(['genre']) || (
          request.resource.data.genre is string
          && request.resource.data.genre.size() > 0
          && request.resource.data.genre.size() <= 40
        ))
        && (!request.resource.data.keys().hasAll(['mood']) || (
          request.resource.data.mood is string
          && request.resource.data.mood.size() > 0
          && request.resource.data.mood.size() <= 40
        ))
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 400000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && (!request.resource.data.keys().hasAll(['isFavorite'])
          || request.resource.data.isFavorite is bool);
      }

      allow create: if ownsIncomingGame() && validGame();
      allow read, delete: if ownsExistingGame();
      allow update: if ownsExistingGame()
                    && ownsIncomingGame()
                    && request.resource.data.userId == resource.data.userId
                    && validGame();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
